#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════
# wg-ctl — Wire_Ghost Management CLI
# ══════════════════════════════════════════════════════════════════════
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# ── Colours ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

info()  { printf "${CYAN}[INFO]${NC}  %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC}    %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC}  %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC}   %s\n" "$*" >&2; }
die()   { printf "${RED}[FATAL]${NC} %s\n" "$*" >&2; exit 1; }

require_env() {
    [ -f .env ] || die ".env not found — run scripts/install.sh first"
    set -a; source .env; set +a
}

_is_host_mode() {
    [ "${INSTALL_MODE:-docker}" = "host" ]
}

_compose_cmd() {
    if _is_host_mode; then
        docker compose -f docker-compose.yml -f docker-compose.host.yml "$@"
    else
        docker compose "$@"
    fi
}

# ══════════════════════════════════════════════════════════════════════
# status — Show service health, cert info, disk usage
# ══════════════════════════════════════════════════════════════════════
cmd_status() {
    require_env

    printf "\n${BOLD}Wire_Ghost Service Status${NC}  ${DIM}(mode: ${INSTALL_MODE:-docker})${NC}\n\n"

    _compose_cmd ps --format 'table {{.Service}}\t{{.State}}\t{{.Health}}\t{{.Ports}}' 2>/dev/null || \
        _compose_cmd ps

    if _is_host_mode; then
        printf "\n${BOLD}Host Services${NC}\n"
        for unit in wireghost-worker wireghost-beat; do
            local state
            state=$(systemctl is-active "$unit" 2>/dev/null || echo "inactive")
            local color="$RED"
            [ "$state" = "active" ] && color="$GREEN"
            printf "  %-24s ${color}%s${NC}\n" "$unit" "$state"
        done
    fi

    printf "\n${BOLD}TLS Certificate${NC}\n"
    if [ -f certs/cert.pem ]; then
        openssl x509 -in certs/cert.pem -noout \
            -subject -dates -fingerprint -sha256 2>/dev/null | \
            sed 's/^/  /'
    else
        warn "  No certificate found"
    fi

    printf "\n${BOLD}Disk Usage${NC}\n"
    printf "  %-20s %s\n" "Docker volumes:" \
        "$(docker system df --format '{{.Size}}' -v 2>/dev/null | head -1 || echo 'unknown')"
    printf "  %-20s %s\n" "Log directory:" \
        "$(du -sh "${WIREGHOST_LOG_DIR:-./logs}" 2>/dev/null | cut -f1 || echo 'unknown')"
    if _is_host_mode && [ -d "${WIREGHOST_DATA_DIR:-./data}" ]; then
        printf "  %-20s %s\n" "Scan data:" \
            "$(du -sh "${WIREGHOST_DATA_DIR:-./data}" 2>/dev/null | cut -f1 || echo 'unknown')"
    fi

    printf "\n${BOLD}Portal URL${NC}\n"
    PORT="${WIREGHOST_PORT:-443}"
    HOST="${WIREGHOST_HOST:-localhost}"
    if [ "$PORT" = "443" ]; then
        printf "  https://%s/\n" "$HOST"
    else
        printf "  https://%s:%s/\n" "$HOST" "$PORT"
    fi
    printf "\n"
}

# ══════════════════════════════════════════════════════════════════════
# backup — Full backup to a single tarball
# ══════════════════════════════════════════════════════════════════════
cmd_backup() {
    require_env

    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    BACKUP_DIR="backups"
    BACKUP_NAME="wireghost_backup_${TIMESTAMP}"
    BACKUP_WORK="${BACKUP_DIR}/.${BACKUP_NAME}"
    BACKUP_FILE="${BACKUP_DIR}/${BACKUP_NAME}.tar.gz"

    mkdir -p "$BACKUP_DIR" "$BACKUP_WORK"

    info "Starting full backup..."

    # 1. Database dump
    info "Dumping MySQL database..."
    _compose_cmd exec -T db mysqldump \
        -u"${MYSQL_USER:-wireghost}" \
        -p"${MYSQL_PASSWORD}" \
        --single-transaction \
        --routines \
        --triggers \
        "${MYSQL_DATABASE:-wireghost}" > "${BACKUP_WORK}/database.sql" 2>/dev/null

    DB_SIZE=$(du -sh "${BACKUP_WORK}/database.sql" | cut -f1)
    ok "Database dump: ${DB_SIZE}"

    # 2. Scan output
    info "Backing up scan output..."
    if _is_host_mode && [ -d "${WIREGHOST_DATA_DIR:-./data}/output" ]; then
        tar czf "${BACKUP_WORK}/scan_output.tar.gz" -C "${WIREGHOST_DATA_DIR}/output" . 2>/dev/null || \
            warn "Could not backup scan output"
    else
        docker run --rm \
            -v "$(docker compose config --volumes | grep scan_output | head -1 || echo 'demon-in-the-wire_scan_output'):/source:ro" \
            -v "$(pwd)/${BACKUP_WORK}:/backup" \
            alpine tar czf /backup/scan_output.tar.gz -C /source . 2>/dev/null || \
        docker run --rm \
            -v "demon-in-the-wire_scan_output:/source:ro" \
            -v "$(pwd)/${BACKUP_WORK}:/backup" \
            alpine tar czf /backup/scan_output.tar.gz -C /source . 2>/dev/null || \
            warn "Could not backup scan_output volume"
    fi

    # 3. Report assets
    info "Backing up report assets..."
    if _is_host_mode && [ -d "${WIREGHOST_DATA_DIR:-./data}/assets" ]; then
        tar czf "${BACKUP_WORK}/report_assets.tar.gz" -C "${WIREGHOST_DATA_DIR}/assets" . 2>/dev/null || \
            warn "Could not backup report assets"
    else
        docker run --rm \
            -v "demon-in-the-wire_report_assets:/source:ro" \
            -v "$(pwd)/${BACKUP_WORK}:/backup" \
            alpine tar czf /backup/report_assets.tar.gz -C /source . 2>/dev/null || \
            warn "Could not backup report_assets volume"
    fi

    # 4. Configuration files
    info "Backing up configuration..."
    cp .env "${BACKUP_WORK}/env.bak"
    [ -f nginx.conf ] && cp nginx.conf "${BACKUP_WORK}/nginx.conf.bak"

    # 5. TLS certificates
    if [ -d certs ] && [ -f certs/cert.pem ]; then
        cp -r certs "${BACKUP_WORK}/certs"
        ok "TLS certificates included"
    fi

    # 6. Create final tarball
    info "Compressing backup..."
    tar czf "$BACKUP_FILE" -C "$BACKUP_DIR" ".${BACKUP_NAME}"
    rm -rf "$BACKUP_WORK"

    FINAL_SIZE=$(du -sh "$BACKUP_FILE" | cut -f1)
    printf "\n"
    ok "Backup complete: ${BACKUP_FILE} (${FINAL_SIZE})"
    printf "  Restore with: ${CYAN}./scripts/wg-ctl restore ${BACKUP_FILE} --confirm${NC}\n\n"
}

# ══════════════════════════════════════════════════════════════════════
# restore — Restore from backup tarball
# ══════════════════════════════════════════════════════════════════════
cmd_restore() {
    local BACKUP_FILE="${1:-}"
    local CONFIRM="${2:-}"

    [ -n "$BACKUP_FILE" ] || die "Usage: wg-ctl restore <backup-file.tar.gz> --confirm"
    [ -f "$BACKUP_FILE" ] || die "Backup file not found: ${BACKUP_FILE}"
    [ "$CONFIRM" = "--confirm" ] || die "Destructive operation — add --confirm to proceed"

    require_env

    RESTORE_DIR=$(mktemp -d)
    trap 'rm -rf "$RESTORE_DIR"' EXIT

    info "Extracting backup..."
    tar xzf "$BACKUP_FILE" -C "$RESTORE_DIR"
    INNER_DIR=$(find "$RESTORE_DIR" -maxdepth 1 -mindepth 1 -type d | head -1)
    [ -d "$INNER_DIR" ] || die "Invalid backup format"

    info "Stopping Wire_Ghost stack..."
    if _is_host_mode; then
        systemctl stop wireghost-beat wireghost-worker 2>/dev/null || true
    fi
    _compose_cmd down

    # Restore .env
    if [ -f "${INNER_DIR}/env.bak" ]; then
        cp "${INNER_DIR}/env.bak" .env
        chmod 600 .env
        ok "Configuration restored"
        set -a; source .env; set +a
    fi

    # Restore nginx.conf
    if [ -f "${INNER_DIR}/nginx.conf.bak" ]; then
        cp "${INNER_DIR}/nginx.conf.bak" nginx.conf
        ok "nginx config restored"
    fi

    # Restore certificates
    if [ -d "${INNER_DIR}/certs" ]; then
        mkdir -p certs
        cp -r "${INNER_DIR}/certs/"* certs/
        chmod 600 certs/key.pem 2>/dev/null || true
        ok "TLS certificates restored"
    fi

    # Start infrastructure to restore database
    info "Starting database..."
    _compose_cmd up -d db redis
    sleep 10

    # Wait for DB health
    TIMEOUT=60; ELAPSED=0
    while [ $ELAPSED -lt $TIMEOUT ]; do
        if _compose_cmd exec -T db mysqladmin ping -h localhost >/dev/null 2>&1; then
            break
        fi
        sleep 3; ELAPSED=$((ELAPSED + 3))
    done

    # Restore database
    if [ -f "${INNER_DIR}/database.sql" ]; then
        info "Restoring database..."
        _compose_cmd exec -T db mysql \
            -u"${MYSQL_USER:-wireghost}" \
            -p"${MYSQL_PASSWORD}" \
            "${MYSQL_DATABASE:-wireghost}" < "${INNER_DIR}/database.sql"
        ok "Database restored"
    fi

    # Restore scan output
    if [ -f "${INNER_DIR}/scan_output.tar.gz" ]; then
        info "Restoring scan output..."
        if _is_host_mode; then
            mkdir -p "${WIREGHOST_DATA_DIR}/output"
            tar xzf "${INNER_DIR}/scan_output.tar.gz" -C "${WIREGHOST_DATA_DIR}/output"
        else
            docker run --rm \
                -v "demon-in-the-wire_scan_output:/target" \
                -v "$(cd "$INNER_DIR" && pwd):/backup:ro" \
                alpine sh -c "rm -rf /target/* && tar xzf /backup/scan_output.tar.gz -C /target"
        fi
        ok "Scan output restored"
    fi

    # Restore report assets
    if [ -f "${INNER_DIR}/report_assets.tar.gz" ]; then
        info "Restoring report assets..."
        if _is_host_mode; then
            mkdir -p "${WIREGHOST_DATA_DIR}/assets"
            tar xzf "${INNER_DIR}/report_assets.tar.gz" -C "${WIREGHOST_DATA_DIR}/assets"
        else
            docker run --rm \
                -v "demon-in-the-wire_report_assets:/target" \
                -v "$(cd "$INNER_DIR" && pwd):/backup:ro" \
                alpine sh -c "rm -rf /target/* && tar xzf /backup/report_assets.tar.gz -C /target"
        fi
        ok "Report assets restored"
    fi

    # Bring up full stack
    info "Starting Wire_Ghost stack..."
    _compose_cmd up -d

    if _is_host_mode; then
        systemctl start wireghost-worker wireghost-beat
    fi

    info "Running migrations..."
    sleep 5
    _compose_cmd exec -T api python manage.py migrate --noinput 2>/dev/null || true

    printf "\n"
    ok "Restore complete — all services started"
    printf "  Verify with: ${CYAN}./scripts/wg-ctl status${NC}\n\n"
}

# ══════════════════════════════════════════════════════════════════════
# update — Pull latest images and rebuild
# ══════════════════════════════════════════════════════════════════════
cmd_update() {
    require_env

    # Check if update was requested from the web portal
    local FLAG_FILE="${WIREGHOST_LOG_DIR:-./logs}/api/update-requested.json"
    if [ -f "$FLAG_FILE" ]; then
        info "Update was requested from the web portal:"
        python3 -m json.tool "$FLAG_FILE" 2>/dev/null || cat "$FLAG_FILE"
        printf "\n"
    fi

    info "Creating pre-update backup..."
    cmd_backup

    info "Pulling latest base images..."
    _compose_cmd pull db redis portal 2>/dev/null || true

    info "Rebuilding application containers..."
    if _is_host_mode; then
        _compose_cmd build --pull api portal
    else
        _compose_cmd build --pull
    fi

    if _is_host_mode; then
        info "Updating host Python dependencies..."
        local VENV_DIR="${PROJECT_DIR}/.venv"
        if [ -d "$VENV_DIR" ]; then
            "$VENV_DIR/bin/pip" install --no-cache-dir -r web_portal/requirements.txt -q
            "$VENV_DIR/bin/pip" install --no-cache-dir -e . -q
        fi
    fi

    info "Applying update..."
    if _is_host_mode; then
        systemctl stop wireghost-beat wireghost-worker 2>/dev/null || true
    fi
    _compose_cmd up -d

    if _is_host_mode; then
        systemctl start wireghost-worker wireghost-beat
    fi

    info "Running database migrations..."
    sleep 5
    _compose_cmd exec -T api python manage.py migrate --noinput

    # Write update status for the web portal
    local STATUS_DIR="${WIREGHOST_LOG_DIR:-./logs}/api"
    mkdir -p "$STATUS_DIR"
    local NEW_VER
    NEW_VER=$(_compose_cmd exec -T api python -c 'from wireghost import __version__; print(__version__)' 2>/dev/null || echo 'unknown')
    printf '{"completed_at": "%s", "version": "%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEW_VER" > "$STATUS_DIR/update-status.json"
    rm -f "$FLAG_FILE"

    printf "\n"
    ok "Update complete (version: ${NEW_VER})"
    printf "  Verify with: ${CYAN}./scripts/wg-ctl status${NC}\n\n"
}

# ══════════════════════════════════════════════════════════════════════
# logs — Stream or tail service logs
# ══════════════════════════════════════════════════════════════════════
cmd_logs() {
    require_env
    local SERVICE="${1:-}"

    if _is_host_mode && { [ "$SERVICE" = "worker" ] || [ "$SERVICE" = "beat" ]; }; then
        journalctl -fu "wireghost-${SERVICE}" --no-pager -n 100
    elif [ -n "$SERVICE" ]; then
        _compose_cmd logs -f --tail=100 "$SERVICE"
    else
        if _is_host_mode; then
            info "Docker logs (api, portal, db, redis):"
        fi
        _compose_cmd logs -f --tail=100
    fi
}

# ══════════════════════════════════════════════════════════════════════
# reset-password — Reset a user's password
# ══════════════════════════════════════════════════════════════════════
cmd_reset_password() {
    require_env
    local USERNAME="${1:-}"
    [ -n "$USERNAME" ] || die "Usage: wg-ctl reset-password <username>"

    info "Resetting password for user: ${USERNAME}"
    _compose_cmd exec api python manage.py changepassword "$USERNAME"
}

# ══════════════════════════════════════════════════════════════════════
# certs — Certificate management
# ══════════════════════════════════════════════════════════════════════
cmd_certs() {
    local SUBCMD="${1:-status}"
    require_env

    case "$SUBCMD" in
        status)
            if [ -f certs/cert.pem ]; then
                printf "\n${BOLD}TLS Certificate Details${NC}\n\n"
                openssl x509 -in certs/cert.pem -noout \
                    -subject -issuer -dates -fingerprint -sha256 \
                    -ext subjectAltName 2>/dev/null | sed 's/^/  /'

                EXPIRY_EPOCH=$(date -d "$(openssl x509 -in certs/cert.pem -noout -enddate 2>/dev/null | cut -d= -f2)" +%s 2>/dev/null || echo 0)
                NOW_EPOCH=$(date +%s)
                DAYS_LEFT=$(( (EXPIRY_EPOCH - NOW_EPOCH) / 86400 ))

                if [ "$DAYS_LEFT" -lt 30 ]; then
                    warn "Certificate expires in ${DAYS_LEFT} days — run: ./wg-ctl certs renew"
                else
                    printf "\n  ${GREEN}Expires in ${DAYS_LEFT} days${NC}\n"
                fi
                printf "\n"
            else
                warn "No certificate found at certs/cert.pem"
            fi
            ;;

        renew)
            HOST="${WIREGHOST_HOST:-localhost}"
            info "Regenerating self-signed certificate for ${HOST}..."

            if echo "$HOST" | grep -qP '^\d+\.\d+\.\d+\.\d+$'; then
                SAN="IP:${HOST}"
            else
                SAN="DNS:${HOST}"
            fi

            mkdir -p certs
            openssl req -x509 -nodes -days 3650 \
                -newkey rsa:2048 \
                -keyout certs/key.pem \
                -out certs/cert.pem \
                -subj "/CN=${HOST}/O=Wire_Ghost" \
                -addext "subjectAltName=${SAN},IP:127.0.0.1,DNS:localhost" \
                2>/dev/null

            chmod 600 certs/key.pem
            chmod 644 certs/cert.pem

            ok "New certificate generated"

            info "Restarting portal to load new certificate..."
            _compose_cmd restart portal
            ok "Portal restarted"
            ;;

        *)
            die "Unknown certs command: ${SUBCMD}. Use: status, renew"
            ;;
    esac
}

# ══════════════════════════════════════════════════════════════════════
# stop / start / restart
# ══════════════════════════════════════════════════════════════════════
cmd_stop() {
    require_env
    if _is_host_mode; then
        systemctl stop wireghost-beat wireghost-worker 2>/dev/null || true
        ok "Host services stopped"
    fi
    _compose_cmd stop
    ok "Wire_Ghost stopped"
}

cmd_start() {
    require_env
    _compose_cmd start
    if _is_host_mode; then
        systemctl start wireghost-worker wireghost-beat
        ok "Host services started"
    fi
    ok "Wire_Ghost started"
}

cmd_restart() {
    require_env
    if _is_host_mode; then
        systemctl stop wireghost-beat wireghost-worker 2>/dev/null || true
    fi
    _compose_cmd restart
    if _is_host_mode; then
        systemctl start wireghost-worker wireghost-beat
        ok "Host services restarted"
    fi
    ok "Wire_Ghost restarted"
}

# ══════════════════════════════════════════════════════════════════════
# uninstall — Remove everything
# ══════════════════════════════════════════════════════════════════════
cmd_uninstall() {
    local CONFIRM="${1:-}"
    [ "$CONFIRM" = "--confirm" ] || die "This will destroy ALL data. Add --confirm to proceed."

    require_env

    warn "This will remove all Wire_Ghost containers, volumes, data, and configuration."
    if [ -t 0 ]; then
        printf "  Type 'DELETE' to confirm: "
        read -r ANSWER
        [ "$ANSWER" = "DELETE" ] || die "Aborted"
    fi

    if _is_host_mode; then
        info "Stopping and removing systemd services..."
        systemctl stop wireghost-beat wireghost-worker 2>/dev/null || true
        systemctl disable wireghost-beat wireghost-worker 2>/dev/null || true
        rm -f /etc/systemd/system/wireghost-worker.service
        rm -f /etc/systemd/system/wireghost-beat.service
        systemctl daemon-reload
        ok "systemd units removed"

        if [ -d "${PROJECT_DIR}/.venv" ]; then
            rm -rf "${PROJECT_DIR}/.venv"
            ok "Python venv removed"
        fi
    fi

    info "Stopping and removing containers and volumes..."
    _compose_cmd down -v

    info "Removing local files..."
    rm -rf certs/ logs/ backups/
    rm -f .env nginx.conf

    if _is_host_mode && [ -d "${PROJECT_DIR}/data" ]; then
        if [ -t 0 ]; then
            printf "  Remove scan data (${PROJECT_DIR}/data)? [y/N] "
            read -r _rm_data
            if [[ "$_rm_data" =~ ^[Yy] ]]; then
                rm -rf "${PROJECT_DIR}/data"
                ok "Scan data removed"
            else
                info "Scan data kept at ${PROJECT_DIR}/data"
            fi
        fi
    fi

    ok "Wire_Ghost uninstalled"
    printf "  Project files (source code) remain intact.\n"
    printf "  Re-install with: ${CYAN}sudo bash scripts/install.sh${NC}\n\n"
}

# ══════════════════════════════════════════════════════════════════════
# shell — Open Django shell in api container
# ══════════════════════════════════════════════════════════════════════
cmd_shell() {
    require_env
    _compose_cmd exec api python manage.py shell
}

# ══════════════════════════════════════════════════════════════════════
# help
# ══════════════════════════════════════════════════════════════════════
cmd_help() {
    printf "\n${BOLD}wg-ctl${NC} — Wire_Ghost Management CLI\n\n"
    printf "${BOLD}Usage:${NC} ./scripts/wg-ctl <command> [args]\n\n"
    printf "${BOLD}Commands:${NC}\n"
    printf "  ${CYAN}%-28s${NC} %s\n" "status"                   "Show service health, cert info, disk usage"
    printf "  ${CYAN}%-28s${NC} %s\n" "backup"                   "Create full backup (DB + volumes + config)"
    printf "  ${CYAN}%-28s${NC} %s\n" "restore <file> --confirm" "Restore from backup tarball"
    printf "  ${CYAN}%-28s${NC} %s\n" "update"                   "Pull latest, rebuild, migrate"
    printf "  ${CYAN}%-28s${NC} %s\n" "logs [service]"           "Stream logs (all or specific service)"
    printf "  ${CYAN}%-28s${NC} %s\n" "reset-password <user>"    "Reset a user's password"
    printf "  ${CYAN}%-28s${NC} %s\n" "certs status"             "Show certificate details and expiry"
    printf "  ${CYAN}%-28s${NC} %s\n" "certs renew"              "Regenerate self-signed certificate"
    printf "  ${CYAN}%-28s${NC} %s\n" "start"                    "Start all services"
    printf "  ${CYAN}%-28s${NC} %s\n" "stop"                     "Stop all services"
    printf "  ${CYAN}%-28s${NC} %s\n" "restart"                  "Restart all services"
    printf "  ${CYAN}%-28s${NC} %s\n" "shell"                    "Open Django management shell"
    printf "  ${CYAN}%-28s${NC} %s\n" "uninstall --confirm"      "Remove all data and configuration"
    printf "\n"
}

# ══════════════════════════════════════════════════════════════════════
# Dispatch
# ══════════════════════════════════════════════════════════════════════
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    status)         cmd_status ;;
    backup)         cmd_backup ;;
    restore)        cmd_restore "$@" ;;
    update)         cmd_update ;;
    logs)           cmd_logs "$@" ;;
    reset-password) cmd_reset_password "$@" ;;
    certs)          cmd_certs "$@" ;;
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    shell)          cmd_shell ;;
    uninstall)      cmd_uninstall "$@" ;;
    help|--help|-h) cmd_help ;;
    *)              err "Unknown command: ${COMMAND}"; cmd_help; exit 1 ;;
esac
