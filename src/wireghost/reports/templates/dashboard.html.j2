<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} - Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<style>{{ css }}</style>
</head>
<body>
<div class="dashboard">

  <!-- Header -->
  <div class="dash-header">
    <div class="dash-header-left">
      <h1>{{ title }}</h1>
      <div class="subtitle">Security Assessment Dashboard</div>
    </div>
    <div class="dash-header-right">
      <div><strong>Target:</strong> {{ target }}</div>
      <div><strong>Date:</strong> {{ date }}</div>
    </div>
  </div>

  <!-- Stats row -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="value">{{ hosts_count }}</div>
      <div class="label">Hosts</div>
    </div>
    <div class="stat-card">
      <div class="value">{{ open_ports }}</div>
      <div class="label">Open Ports</div>
    </div>
    <div class="stat-card">
      <div class="value">{{ total_findings }}</div>
      <div class="label">Findings</div>
    </div>
    <div class="stat-card">
      <div class="value">{{ tech_count }}</div>
      <div class="label">Technologies</div>
    </div>
    <div class="stat-card stat-critical">
      <div class="value">{{ critical }}</div>
      <div class="label">Critical</div>
    </div>
    <div class="stat-card stat-high">
      <div class="value">{{ high }}</div>
      <div class="label">High</div>
    </div>
    <div class="stat-card stat-medium">
      <div class="value">{{ medium }}</div>
      <div class="label">Medium</div>
    </div>
  </div>

  <!-- Executive Summary -->
  <div class="exec-summary">
    <h2 class="section-title">Executive Summary</h2>
    <span class="risk-badge risk-{{ risk_level|lower }}">{{ risk_level }} RISK</span>
    <div class="charts-row">
      <div class="chart-container">
        <h3>Severity Distribution</h3>
        <canvas id="severityChart"></canvas>
      </div>
      <div class="chart-container">
        <h3>Findings by Source</h3>
        <canvas id="sourceChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Technologies -->
  {% if technologies %}
  <div class="tech-section">
    <h2 class="section-title">Detected Technologies <span class="count">{{ technologies|length }}</span></h2>
    <div class="tech-grid">
      {% for tech in technologies %}
      <span class="tech-badge">
        {{ tech.name }}{% if tech.version %} <span class="tech-version">{{ tech.version }}</span>{% endif %}
      </span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- Known Exploits -->
  {% if exploits %}
  <div class="card exploits-section">
    <h2 class="section-title">Known Exploits <span class="count">{{ exploits|length }}</span></h2>
    <p style="color:#8b949e;margin-bottom:1rem;">Public exploits found in Exploit-DB matching detected software versions.</p>
    <table class="exploits-table">
      <thead>
        <tr><th>Severity</th><th>Host</th><th>Port</th><th>Detected Version</th><th>Exploit Title</th><th>EDB-ID</th><th>References</th></tr>
      </thead>
      <tbody>
        {% for e in exploits %}
        <tr>
          <td><span class="badge badge-{{ e.severity }}">{{ e.severity }}</span></td>
          <td>{{ e.host }}</td>
          <td>{{ e.port }}</td>
          <td>{% if e.raw_output %}<span class="tech-badge">{{ e.raw_output }}</span>{% endif %}</td>
          <td>{{ e.title }}</td>
          <td>
            {% if e.template_id %}
            <a href="https://www.exploit-db.com/exploits/{{ e.template_id|replace('EDB-', '') }}" target="_blank" style="color:#58a6ff;">{{ e.template_id }}</a>
            {% endif %}
          </td>
          <td>
            {% for ref in e.references %}
              {% if 'CVE-' in ref %}
              <span class="meta-badge meta-cve">{{ ref }}</span>
              {% endif %}
            {% endfor %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- Findings -->
  <div class="findings-section">
    <h2 class="section-title">Vulnerability Findings <span class="count">{{ findings|length }}</span></h2>

    <div class="controls">
      <div class="sev-toggles">
        <button class="sev-btn" data-sev="critical">Critical</button>
        <button class="sev-btn" data-sev="high">High</button>
        <button class="sev-btn" data-sev="medium">Medium</button>
        <button class="sev-btn" data-sev="low">Low</button>
        <button class="sev-btn off" data-sev="info">Info</button>
      </div>
      <div class="controls-sep"></div>
      <select id="sourceFilter" class="source-filter">
        <option value="all">All Sources</option>
        {% for src in sources %}
        <option value="{{ src }}">{{ src }}</option>
        {% endfor %}
      </select>
      <select id="sortSelect" class="sort-select">
        <option value="severity">Sort: Severity</option>
        <option value="host">Sort: Host</option>
      </select>
      <input id="searchInput" class="search-box" type="text" placeholder="Search findings (title, host, CVE...)">
    </div>

    <div id="findingsList">
      {% for f in findings %}
      <div class="finding-card sev-{{ f.severity }}" data-severity="{{ f.severity }}" data-source="{{ f.source }}" data-host="{{ f.host }}">
        <div class="finding-header">
          <span class="chevron">&#9654;</span>
          <span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>
          <span class="finding-title">{{ f.title }}</span>
          <span class="finding-source">{{ f.source }}</span>
          <span class="finding-meta">{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}</span>
        </div>
        <div class="finding-detail">
          {% if f.description %}
          <div class="finding-description">{{ f.description }}</div>
          {% endif %}

          {% if f.cve or f.cwe or f.cvss %}
          <div class="meta-badges">
            {% if f.cve %}<span class="meta-badge cve-badge">CVE: {{ f.cve }}</span>{% endif %}
            {% if f.cwe %}<span class="meta-badge cwe-badge">CWE: {{ f.cwe }}</span>{% endif %}
            {% if f.cvss %}<span class="meta-badge cvss-badge">CVSS: {{ f.cvss }}</span>{% endif %}
          </div>
          {% endif %}

          {% if f.curl_command %}
          <div class="curl-section">
            <button class="copy-btn">Copy</button>
            <code>{{ f.curl_command }}</code>
          </div>
          {% endif %}

          {% if f.request %}
          <details class="evidence">
            <summary>HTTP Request</summary>
            <pre class="code-block">{{ f.request }}</pre>
          </details>
          {% endif %}

          {% if f.response %}
          <details class="evidence">
            <summary>HTTP Response</summary>
            <pre class="code-block">{{ f.response }}</pre>
          </details>
          {% endif %}

          {% if f.references %}
          <div class="refs">
            <div class="refs-title">References</div>
            {% for ref in f.references %}
            <a href="{{ ref }}" target="_blank" rel="noopener noreferrer">{{ ref }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>

    <div id="noResults" class="no-results" style="display:none">
      No findings match the current filters.
    </div>
  </div>

  <!-- Hosts -->
  <div class="hosts-section">
    <h2 class="section-title">Host Details <span class="count">{{ hosts|length }}</span></h2>
    {% for host in hosts %}
    <div class="host-panel">
      <button class="host-toggle">
        <span>
          <span class="host-ip">{{ host.ip }}</span>
          {% if host.hostname %}<span class="host-info">({{ host.hostname }})</span>{% endif %}
          <span class="host-info">&mdash; {{ host.open_ports|length }} open port(s){% if host.os %} &mdash; {{ host.os }}{% endif %}</span>
        </span>
        <span class="chevron">&#9654;</span>
      </button>
      <div class="host-detail" style="display:none">
        {% if host.technologies %}
        <div class="host-techs">
          {% for tech in host.technologies %}
          <span class="tech-badge">{{ tech.name }}{% if tech.version %} <span class="tech-version">{{ tech.version }}</span>{% endif %}</span>
          {% endfor %}
        </div>
        {% endif %}
        {% if host.open_ports %}
        <table>
          <thead>
            <tr><th>Port</th><th>Protocol</th><th>Service</th><th>Product</th><th>Version</th></tr>
          </thead>
          <tbody>
            {% for p in host.open_ports %}
            <tr>
              <td>{{ p.number }}</td>
              <td>{{ p.protocol }}</td>
              <td>{{ p.service.name }}</td>
              <td>{{ p.service.product }}</td>
              <td>{{ p.service.version }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p style="color: var(--text-secondary); font-size: 0.85rem; padding: 0.5rem 0;">No open ports.</p>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="dash-footer">
    Wire_Ghost Security Assessment &mdash; Generated {{ date }}
  </div>

</div>

<script>
window.__SCAN_DATA__ = {{ scan_json }};
</script>
<script>{{ js }}</script>
</body>
</html>
