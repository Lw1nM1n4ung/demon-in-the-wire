# Wire_Ghost — Environment Variables
# Copy to .env and fill in real values: cp .env.example .env

# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=wireghost
MYSQL_USER=wireghost
MYSQL_PASSWORD=change_me_db

# Redis
REDIS_PASSWORD=change_me_redis

# Host IP (for ALLOWED_HOSTS + CORS)
WIREGHOST_HOST=localhost

# Logging — host directory where per-service logs are persisted.
# Relative paths resolve against the repo root. Use an absolute path
# (e.g. /var/log/wireghost) for production.
WIREGHOST_LOG_DIR=./logs

# Log verbosity for the Django app layer (scanner, wireghost_web loggers).
# One of: DEBUG, INFO, WARNING, ERROR.
WIREGHOST_LOG_LEVEL=INFO

# Internal test seam — override the *in-container* log directory that the
# support-bundle builder reads from. Defaults to /app/logs (bind-mounted to
# $WIREGHOST_LOG_DIR/api on the host). You almost never need to set this —
# tests use it to point the builder at a temp directory.
# WIREGHOST_LOG_FILE_DIR=/app/logs
