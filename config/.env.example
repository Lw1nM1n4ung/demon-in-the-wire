# Wire_Ghost — Environment Variables
#
# FOR PRODUCTION:  Run "sudo bash install.sh" — it generates secrets and writes
#                  .env automatically. You do not need to edit this file.
#
# FOR DEVELOPMENT: cp .env.example .env  &&  fill in the blanks below.

# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=wireghost
MYSQL_USER=wireghost
MYSQL_PASSWORD=change_me_db

# Redis
REDIS_PASSWORD=change_me_redis

# ── Portal access ────────────────────────────────────────────────────

# Protocol — https for production (install.sh sets this), http for dev.
WIREGHOST_PROTO=https

# HTTPS port the portal listens on (443 for production, 9995 for dev).
WIREGHOST_PORT=443

# Hostname or IP the portal is reached at.
#   - localhost           host-only dev setup (default)
#   - <IP or hostname>    a single public endpoint
#   - *                   accept any Host header (LAN/VPN convenience)
WIREGHOST_HOST=localhost

# Cookie security — true when serving over HTTPS, false for HTTP dev.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Django CSRF trusted origins — install.sh auto-generates this.
# Comma-separated list of scheme+host+port that may POST to the API.
# CSRF_TRUSTED_ORIGINS=https://your-host:443,https://localhost:443,https://127.0.0.1:443

# ── Logging ──────────────────────────────────────────────────────────

# Host directory where per-service logs are persisted.
WIREGHOST_LOG_DIR=./logs

# Log verbosity for the Django app layer. One of: DEBUG, INFO, WARNING, ERROR.
WIREGHOST_LOG_LEVEL=INFO

# Internal test seam — override the in-container log directory.
# WIREGHOST_LOG_FILE_DIR=/app/logs
